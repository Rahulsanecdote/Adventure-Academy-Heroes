# Colyseus game server environment (copy to .env or set in your host's panel)
PORT=2567
# Must EXACTLY match the FastAPI backend's SECRET_KEY — game tokens are
# HS256 JWTs issued by FastAPI and verified here in onAuth.
GAME_JWT_SECRET=dev-secret-key-change-in-production
# FastAPI base URL + shared internal secret for boss-defeat rewards.
# Leave either empty and boss victories become bragging-rights only
# (the defeat is still broadcast; no XP/coins are requested).
FASTAPI_URL=http://localhost:8001
MULTIPLAYER_INTERNAL_SECRET=
# Optional: path to the canonical phrase list. Defaults resolve the repo
# checkout (frontend/src/game/net/phrases.json) or the Docker copy.
PHRASES_PATH=
