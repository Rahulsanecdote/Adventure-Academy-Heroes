# KidQuest web: FastAPI backend serving the built frontend on one port.
# Stage 1 builds frontend/dist with the production game-server URL baked in.
# NOTE: this is the clean CI version of the deploy runbook's Dockerfile.web —
# no sandbox CA / fetch-retry patches (those were local-VM egress workarounds).
FROM node:20-alpine AS frontend-build
WORKDIR /build
ARG VITE_GAME_SERVER_URL=wss://kidquest-game.fly.dev
ENV VITE_GAME_SERVER_URL=$VITE_GAME_SERVER_URL
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# Stage 2 mirrors the repo layout main.py expects:
#   <root>/backend/app/main.py  and  <root>/frontend/dist
FROM python:3.11-slim
WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt
COPY backend/ backend/
COPY --from=frontend-build /build/dist frontend/dist
WORKDIR /app/backend
EXPOSE 8001
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
