# FastAPI backend environment (copy to .env)
MONGO_URL=mongodb://localhost:27017
# SECRET_KEY signs BOTH parent JWTs and the short-lived Phase 2 game tokens.
# The game server's GAME_JWT_SECRET must be set to this same value.
SECRET_KEY=dev-secret-key-change-in-production
# Phase 2: shared secret for the game server -> POST /api/multiplayer/boss-reward
# bridge. Leave empty to disable boss rewards (boss victories are then
# bragging-rights only). Must match the game server's MULTIPLAYER_INTERNAL_SECRET.
MULTIPLAYER_INTERNAL_SECRET=
